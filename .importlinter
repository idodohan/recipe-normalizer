[importlinter]
root_package = recipe_normalizer

[importlinter:contract:users-cannot-import-sibling-models]
name = users module must not import sibling models
type = forbidden
source_modules =
    recipe_normalizer.users
forbidden_modules =
    recipe_normalizer.catalog.models
    recipe_normalizer.cookbook.models
    recipe_normalizer.ingestion.models
    recipe_normalizer.sharing.models

[importlinter:contract:catalog-cannot-import-sibling-models]
name = catalog module must not import sibling models
type = forbidden
source_modules =
    recipe_normalizer.catalog
forbidden_modules =
    recipe_normalizer.users.models
    recipe_normalizer.cookbook.models
    recipe_normalizer.ingestion.models
    recipe_normalizer.sharing.models
ignore_imports =
    recipe_normalizer.catalog.router -> recipe_normalizer.api_deps

[importlinter:contract:cookbook-cannot-import-sibling-models]
name = cookbook module must not import sibling models
type = forbidden
source_modules =
    recipe_normalizer.cookbook
forbidden_modules =
    recipe_normalizer.users.models
    recipe_normalizer.catalog.models
    recipe_normalizer.ingestion.models
    recipe_normalizer.sharing.models
ignore_imports =
    recipe_normalizer.catalog.service -> recipe_normalizer.catalog.models
    recipe_normalizer.cookbook.router -> recipe_normalizer.api_deps
    # Task 6: cookbook_router (the separate cookbook-CRUD/membership router
    # module) reads the authenticated user the same way cookbook.router does.
    recipe_normalizer.cookbook.cookbook_router -> recipe_normalizer.api_deps
    # Task 4: cookbook.service resolves email -> user for member invites via
    # users.service.get_user_by_email (never users.models directly) — same
    # pattern sharing.service already uses for its own recipient lookups.
    recipe_normalizer.cookbook.service -> recipe_normalizer.users.service

[importlinter:contract:cookbook-cannot-import-sharing]
name = cookbook module must not import sharing (sharing depends on cookbook, never the reverse)
type = forbidden
source_modules =
    recipe_normalizer.cookbook
forbidden_modules =
    recipe_normalizer.sharing

[importlinter:contract:sharing-cannot-import-sibling-models]
name = sharing module must not import sibling models (only cookbook.service/schemas and users.service)
type = forbidden
source_modules =
    recipe_normalizer.sharing
forbidden_modules =
    recipe_normalizer.users.models
    recipe_normalizer.catalog.models
    recipe_normalizer.cookbook.models
    recipe_normalizer.ingestion.models
ignore_imports =
    recipe_normalizer.sharing.router -> recipe_normalizer.api_deps
    recipe_normalizer.sharing.service -> recipe_normalizer.users.service
    recipe_normalizer.sharing.service -> recipe_normalizer.cookbook.service

[importlinter:contract:extraction-boundaries]
name = extraction must not import sibling models nor ingestion (stateless; spec section 4)
type = forbidden
source_modules =
    recipe_normalizer.extraction
forbidden_modules =
    recipe_normalizer.users.models
    recipe_normalizer.catalog.models
    recipe_normalizer.cookbook.models
    recipe_normalizer.ingestion
    recipe_normalizer.sharing.models
ignore_imports =
    recipe_normalizer.cookbook.service -> recipe_normalizer.cookbook.models
    recipe_normalizer.catalog.service -> recipe_normalizer.catalog.models
    # See the cookbook-cannot-import-sibling-models contract above — same edge.
    recipe_normalizer.cookbook.service -> recipe_normalizer.users.service

[importlinter:contract:ai-cannot-import-sibling-models]
name = ai module must not import sibling models (only cookbook/ingestion/sharing/users service+schemas, extraction's stateless normalize+persist, and llm client+schema layers)
type = forbidden
source_modules =
    recipe_normalizer.ai
forbidden_modules =
    recipe_normalizer.users.models
    recipe_normalizer.catalog.models
    recipe_normalizer.cookbook.models
    recipe_normalizer.ingestion.models
    recipe_normalizer.sharing.models
    recipe_normalizer.llm.models
ignore_imports =
    recipe_normalizer.ai.router -> recipe_normalizer.api_deps
    recipe_normalizer.ai.service -> recipe_normalizer.cookbook.service
    recipe_normalizer.llm.client -> recipe_normalizer.llm.models
    # Task 6 (transformations): ai.service reuses extraction.persist.persist_drafts
    # (the SAME draft-conversion/catalog-matching path the worker uses — DRY, not a
    # reimplementation) and ingestion.service.create_transform_job (which lands a
    # transform's draft in the EXISTING review gate as a Job already in
    # needs_review). Both edges are cut here exactly like the cookbook.service edge
    # above — ai never touches ingestion.models or cookbook.models directly, only
    # these two services' own public functions.
    recipe_normalizer.ai.service -> recipe_normalizer.extraction.persist
    recipe_normalizer.ai.service -> recipe_normalizer.ingestion.service

[importlinter:contract:nothing-imports-ai]
name = no other module may import ai (ai sits at the top of the dependency graph, like sharing but one layer further out)
type = forbidden
source_modules =
    recipe_normalizer.catalog
    recipe_normalizer.cookbook
    recipe_normalizer.ingestion
    recipe_normalizer.sharing
    recipe_normalizer.users
    recipe_normalizer.extraction
    recipe_normalizer.llm
forbidden_modules =
    recipe_normalizer.ai

[importlinter:contract:ingestion-cannot-import-sibling-models]
name = ingestion module must not import sibling models
type = forbidden
source_modules =
    recipe_normalizer.ingestion
forbidden_modules =
    recipe_normalizer.users.models
    recipe_normalizer.catalog.models
    recipe_normalizer.cookbook.models
    recipe_normalizer.sharing.models
ignore_imports =
    recipe_normalizer.ingestion.router -> recipe_normalizer.api_deps
    recipe_normalizer.cookbook.service -> recipe_normalizer.cookbook.models
    recipe_normalizer.catalog.service -> recipe_normalizer.catalog.models
    # See the cookbook-cannot-import-sibling-models contract above — same edge.
    recipe_normalizer.cookbook.service -> recipe_normalizer.users.service
