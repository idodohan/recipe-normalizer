# ============================================================
# Recipe Normalizer — Production Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values before deploying.
# All variables prefixed with RN_ are application-specific.
# ============================================================

# --- Database ---
# PostgreSQL connection string. Use your managed database URL in production.
RN_DATABASE_URL=postgresql+psycopg://rn:CHANGE_ME@localhost:5432/rn

# --- File Storage ---
# Directory for uploaded PDFs, images, etc. Must be a persistent volume.
RN_FILE_STORE_ROOT=/data/filestore

# --- Security ---
# MUST be "true" when serving over HTTPS (production). Set to "false" only for local dev.
RN_COOKIE_SECURE=true

# --- LLM Provider ---
# Which LLM backend to use: "auto" (tries OpenRouter first), "openrouter", or "anthropic"
RN_LLM_PROVIDER=auto

# OpenRouter API key (required if using openrouter or auto)
OPENROUTER_API_KEY=

# Anthropic API key (optional, only needed if RN_LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=

# Optional: override the default model selection
# RN_LLM_MODEL=
# RN_LLM_FAST_MODEL=

# Maximum LLM cost per ingestion job in USD (default: 1.50)
# RN_JOB_COST_CAP_USD=1.50

# --- Testing Only (do NOT set in production) ---
# RN_LLM_STUB=1           # Uses stub LLM responses instead of real API calls
# RN_NETGUARD_ALLOW_HOSTS= # Bypass SSRF protection for specific hosts (testing only)
